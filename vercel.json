{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "functions": {
    "api/[...route].ts": { "runtime": "nodejs22.x" },
    "api/admin/index.ts": { "runtime": "nodejs22.x" }
  },
  "rewrites": [
    { "source": "/api/admin/(.*)", "destination": "/api/admin/index.ts" },
    { "source": "/api/(.*)", "destination": "/api/[...route].ts" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
