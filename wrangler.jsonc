{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyhub",
  "compatibility_date": "2026-09-08",
  "pages_build_output_dir": "./public",
  "compatibility_flags": ["nodejs_compat"],
  // NOTE ON URLS: Cloudflare Pages by default redirects /notes.html -> /notes.
  // That would change the site's URLs and break the frontend's own path
  // checks (refreshCurrentPage / setActiveNavLink compare location.pathname
  // against 'notes.html'). scripts/build.mjs therefore emits a public/_redirects
  // file that serves every .html path directly with a 200, preserving the
  // original URLs exactly. (wrangler's Pages config rejects html_handling at
  // the top level, so _redirects is the supported mechanism here.)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studyhub-production",
      "database_id": "bd3d6fb7-7749-43ca-bcb0-48e614b4a14c"
    }
  ],
  // R2 is intentionally NOT configured during local development.
  // With STORAGE_DRIVER=local, file blobs live in the D1 `files` table.
  // At deploy time, set STORAGE_DRIVER=r2 and add an r2_buckets binding
  // named FILES; the storage driver switches over with no frontend change.
  "vars": {
    // OpenAI-compatible provider configuration.
    // No API key and no model are assumed; both are supplied later via secrets.
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_MODEL": "",
    "STORAGE_DRIVER": "local"
  }
}
