# Local development environment for the Next.js runtime (branch: nextjs).
#
# DEVELOPER_EMAILS (comma-separated) is the developer bootstrap for this
# deployment: pages/api/[...route].js checks it right after a successful
# POST /api/auth/login or /api/auth/register and grants role='developer' to a
# matching account. Without it a fresh database has zero developers and /admin
# can never be entered. The account must exist first -- sign up in the app,
# then log in once and the role is applied.
#
# Local database: .data/studyhub.db (node:sqlite). Turso/OpenAI are optional
# and only needed to run against a hosted setup or enable the AI features.

DEVELOPER_EMAILS=demo@studyhub.local
